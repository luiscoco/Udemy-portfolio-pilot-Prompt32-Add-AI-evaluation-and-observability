DATA_MODE=mock
DATABASE_URL=
REDIS_URL=
ANTHROPIC_API_KEY=
WORKER_ROLE=
MOCK_START_AT=
MOCK_NEWS_INTERVAL_MS=30000
MOCK_SCENARIO=ordinary
INGESTION_INTERVAL_MS=30000
PROVIDER_TIMEOUT_MS=10000
# Live access requires supplied server credentials AND permission covering durable storage/display.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STORAGE_DISPLAY_RIGHTS_CONFIRMED=false
# true runs at most one due page; default runs continuously.
WORKER_ONCE=false
# WORKER_ROLE=outbox publishes committed OutboxEvent rows to Redis Streams (needs DATABASE_URL and REDIS_URL).
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_POLL_MS=500

# WORKER_ROLE=agent executes durable AgentRun jobs. PostgreSQL is required; Redis delivery uses the outbox role.
# Use the same admission limits/model/mode configuration on API and worker processes.
AGENT_MODE=mock
AGENT_MODEL_ID=
AGENT_WORKSPACE_DIR=
AGENT_MOCK_STREAM_DELAY_MS=25
AGENT_MAX_PROMPT_BYTES=48000
AGENT_MAX_TOOL_RESULT_BYTES=24000
AGENT_MAX_TURNS=6
AGENT_WALL_CLOCK_MS=90000
AGENT_MAX_COST_USD=0.10
AGENT_COST_OVERFLOW_USD=0.10
AGENT_DAILY_BUDGET_USD=2.00
AGENT_CONTEXT_RESET_TURNS=8

# Private completed-turn artifacts; keep this persistent and separate from AGENT_WORKSPACE_DIR.
# Local development defaults to <repository>/.local/session-artifacts. Production requires an absolute path.
SESSION_ARTIFACT_BACKEND=local
SESSION_ARTIFACT_DIR=
# Azure: existing private container, no SAS/query string. AKS injects the three AZURE_* identity variables.
SESSION_BLOB_CONTAINER_URL=
# SESSION_ARTIFACT_BACKEND=azure
# AZURE_TENANT_ID=<tenant UUID>
# AZURE_CLIENT_ID=<workload identity UUID>
# AZURE_FEDERATED_TOKEN_FILE=<absolute projected service-account-token path>

# Milestone 30 operational controls (same values on every replica).
# INSTANCE_ID=worker-1
# Claim loops in this process, and live agent leases across ALL replicas (worker <= global).
AGENT_WORKER_CONCURRENCY=1
AGENT_GLOBAL_CONCURRENCY=8
# Graceful drain: stop claiming, let work finish, abort and record "interrupted" ~5 s before exit.
# Keep the orchestrator's termination grace period above this value.
WORKER_SHUTDOWN_GRACE_MS=25000
# Optional /health/live and /health/ready probe listener (loopback unless a pod probe needs 0.0.0.0).
# WORKER_HEALTH_PORT=9464
# WORKER_HEALTH_HOST=127.0.0.1
# Queue-depth log interval and stuck-job thresholds (also used by the admin command).
OPS_REPORT_INTERVAL_MS=60000
STUCK_QUEUED_MS=120000
STUCK_RUNNING_GRACE_MS=60000
# Administrative recovery (`npm run admin --workspace=@portfolio-pilot/worker -- status`) reads the
# operator token ONLY from PORTFOLIO_ADMIN_TOKEN. Never put a real token in this file.
