# Local development only. These example credentials are public and must never be used in production.
DATA_MODE=mock
DATABASE_URL=postgresql://portfolio_local:local_only_change_me@127.0.0.1:5432/portfolio_pilot
REDIS_URL=redis://127.0.0.1:6379
ANTHROPIC_API_KEY=
# Optional milestone 23 research paths. Defaults preserve the simple single-agent path.
AGENT_SPECIALISTS_ENABLED=false
RESEARCH_MCP_MODE=off
# live mode: operator-reviewed absolute Node.js stdio server script and a dedicated research token.
RESEARCH_MCP_SCRIPT_PATH=
RESEARCH_MCP_TOKEN=
AGENT_MODE=
AGENT_MODEL_ID=
# Milestone 26 limits are server-only. SDK cost is an estimate, never a bill.
AGENT_MAX_PROMPT_BYTES=48000
AGENT_MAX_TOOL_RESULT_BYTES=24000
AGENT_MAX_TURNS=6
AGENT_WALL_CLOCK_MS=90000
AGENT_MAX_COST_USD=0.10
AGENT_COST_OVERFLOW_USD=0.10
AGENT_DAILY_BUDGET_USD=2.00
AGENT_CONTEXT_RESET_TURNS=8
# Absolute clean directory outside this source repository and personal agent configuration.
# App-managed skills live in <dir>/skills; CLAUDE_CONFIG_DIR=<dir>, settingSources=['user'].
# Project/local settings, personal plugins/MCP/permissions are excluded. See lesson 24.
AGENT_WORKSPACE_DIR=

# Explicit local-only opt-in. Production refuses this setting.
DEMO_AUTH_ENABLED=true
AUTH_BASE_URL=http://localhost:5173
# Optional locally; required in production (at least 32 random characters).
# AUTH_SECRET=
# Omit all Entra settings for the credential-free local demo.
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_TENANT_ID=

# Deterministic mock schedule; no external credentials required.
MOCK_NEWS_INTERVAL_MS=30000
MOCK_SCENARIO=ordinary
# Optional fixed UTC epoch for repeatable replay; otherwise starts with the API process.
# MOCK_START_AT=2026-10-02T12:00:00.000Z

# Milestone 30 operational controls. Every API and worker replica must share AUTH_SECRET (session
# cookies and signed SSE cursors) and the same limit values; INSTANCE_ID requires AUTH_SECRET.
# INSTANCE_ID=api-a
# Managed server (`npm run start:managed`): PORT/API_HOSTNAME and the bounded drain deadline.
# PORT=3001
# API_HOSTNAME=127.0.0.1
API_SHUTDOWN_GRACE_MS=20000
# Per-user fixed one-minute windows shared through Redis (per-replica fallback during a Redis outage).
API_RATE_LIMIT_PER_MINUTE=300
AGENT_SUBMIT_RATE_LIMIT_PER_MINUTE=12
# Active (queued + running + waiting) assistant answers per user, enforced in PostgreSQL admission.
AGENT_MAX_ACTIVE_RUNS_PER_USER=2
